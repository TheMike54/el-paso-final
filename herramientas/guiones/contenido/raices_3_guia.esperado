# La primera conversación termina contando (etapa 1) y entrega el mapa de Las Raíces y la pluma del mapa; la segunda,
# de una línea, sube la etapa a 2 sin repetir los premios (cada señal cuenta 1). Sin daño.
en 65 valor Guia etapa 1
en 65 senal /root/Eventos mapa_obtenido 1
x 308 2
y 1080 2
en_suelo true
valor Guia etapa 2
valor Jugador hablando false
valor /root/Partida habilidades [&"pluma_mapa"]
valor /root/Partida mapas ["raices"]
senal /root/Eventos habilidad_obtenida 1
senal /root/Eventos mapa_obtenido 1
senal /root/Eventos jugador_danado 0
