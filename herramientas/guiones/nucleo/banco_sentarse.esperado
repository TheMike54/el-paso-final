# Se acomodo sobre el banco (x=600) y se quedo sentado; la partida se guardo una vez.
x 600 1
valor Jugador descansando true
senal /root/Eventos partida_guardada 1
senal /root/Eventos descanso_en_banco 1

# Antes en vibracion_banco.guion:
# Descansar vibra una vez, con su propio patron.
valor Vibracion pedidas 1
valor Vibracion ultima al_descansar

# Antes en aviso_guardado.guion:
# Justo despues de guardar se ve el aviso «Partida guardada».
valor Interfaz/Hud aviso_visible true
