# Una parada (el golpe parable, con su senal) y un disparo desviado (sin senal de parry, suena como pegarle a un
# objeto); el golpe no parable dana una vez.
valor Muneco/Comportamiento golpes_dados 2
valor Muneco/Comportamiento disparos 1
valor Jugador paradas 1
valor Jugador desviados 1
valor Jugador vidas 3
senal /root/Eventos parry 1
senal /root/Eventos objeto_golpeado 1
senal /root/Eventos jugador_danado 1
