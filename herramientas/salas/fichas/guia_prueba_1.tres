[gd_resource type="Resource" script_class="FichaDialogo" format=3 uid="uid://c8ixk40hfha7"]

[ext_resource type="Script" uid="uid://dycfvji2i3yph" path="res://nucleo/ficha_dialogo.gd" id="1_ficha"]
[ext_resource type="Script" uid="uid://cvgtxxidjsdxl" path="res://nucleo/linea_dialogo.gd" id="2_linea"]
[ext_resource type="Script" uid="uid://cltshx6hm4a3b" path="res://nucleo/recompensa.gd" id="3_recompensa"]

[sub_resource type="Resource" id="linea_1"]
script = ExtResource("2_linea")
quien = "Guía"
texto = "Hola, alumno."

[sub_resource type="Resource" id="linea_2"]
script = ExtResource("2_linea")
quien = "Guía"
texto = "¿Quieres el mapa?"
opciones = Array[String](["Sí", "No"])
destinos = Array[int]([2, -2])

[sub_resource type="Resource" id="linea_3"]
script = ExtResource("2_linea")
quien = "Guía"
texto = "Toma, y suerte."

[sub_resource type="Resource" id="recompensa_pluma"]
