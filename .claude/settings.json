{
  "attribution": { "commit": "", "pr": "", "sessionUrl": false },
  "permissions": {
    "deny": [
      "Bash(git commit *)", "Bash(git push *)",
      "PowerShell(git commit *)", "PowerShell(git push *)",
      "Read(**/*.keystore)", "Read(**/*.jks)", "Read(**/.env*)", "Read(**/*.pem)", "Read(**/*.key)",
      "mcp__godot__create_scene", "mcp__godot__add_node", "mcp__godot__save_scene", "mcp__godot__load_sprite"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/sin-commit.ps1"],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${CLAUDE_PROJECT_DIR}/.claude/hooks/al-compactar.ps1"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
